#include <iostream>
using namespace std;

int main(){

    int pos;

    cout<<"Enter position to delete: ";
    cin>>pos;


    int array[7]={10, 20, 30, 40, 50, 60, 70};
    cout<<"After deletion array is \n";


    for(int i=pos;i<7;i++)
    array[i]=array[i+1];


    for(int i=pos;i<6;i++)
    cout<<"Index of position "<<pos++<<" is: "<<array[i]<<"\n";

    
    return 0;

}
