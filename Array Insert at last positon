#include <iostream>
using namespace std;

int main() 
{

    int value;

    cout << "Enter value to insert: ";
    cin >> value;

    int array[8] = {10, 20, 30, 40, 50, 60, 70};

    array[7] = value;

    cout << "After insertion array is:\n";

    for (int i = 0; i < 8; i++) 
    {
        cout << "Index of position " << i << " is: " << array[i] << "\n";
    }

    return 0;
}
