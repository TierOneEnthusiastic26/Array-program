#include <iostream>
using namespace std;

int main() 
{
    int pos;
    int array[7] = {10, 20, 30, 40, 50, 60, 70};

    cout << "Enter position to delete (0-6): ";
    cin >> pos;

    for (int i = pos; i < 6; i++) 
    {
        array[i] = array[i + 1];
    }
    cout << "After deletion array is:\n";
    
    for (int i = 0; i < 6; i++) 
    {
        cout << array[i] << "\n";
    }

    return 0;
}
